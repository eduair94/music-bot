# Discord OAuth
AUTH_DISCORD_ID=your_discord_client_id
AUTH_DISCORD_SECRET=your_discord_client_secret

# Auth.js Secret (generate with: npx auth secret)
AUTH_SECRET=your_auth_secret_here

# Next.js
NEXTAUTH_URL=http://localhost:3001

# MongoDB Connection String (same as bot)
MONGODB_URI=mongodb://localhost:27017/music-bot

# Redis Connection (same as bot - for real-time bot-dashboard sync)
REDIS_URL=redis://localhost:6379

# Bot Configuration
DISCORD_BOT_TOKEN=your_bot_token
DISCORD_BOT_CLIENT_ID=your_bot_client_id
# Bypass fleet: extra bots as "<instance>:<application id>" pairs (same value as the bot's .env)
FLEET_APPLICATION_IDS=

# Bot Owner ID (for admin panel access)
OWNER_ID=your_discord_user_id

# Admin Insights password (gates the /insights analytics area; password-only,
# independent of Discord login). Leave empty to disable password access.
ADMIN_PASSWORD=

# Owner console log streaming: the bot's DebugPanel (services/debugPanel.ts).
# In docker compose the bot is reachable by service name; DEBUG_TOKEN must equal the bot's.
DEBUG_PANEL_URL=http://music-bot:9090
DEBUG_TOKEN=

# Linked Bots Encryption (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
BOT_ENCRYPTION_KEY=your_64_character_hex_encryption_key

# Patreon Integration (Optional - for premium features)
PATREON_CLIENT_ID=your_patreon_client_id
PATREON_CLIENT_SECRET=your_patreon_client_secret
PATREON_CREATOR_ACCESS_TOKEN=your_patreon_creator_access_token
PATREON_CAMPAIGN_ID=your_patreon_campaign_id
PATREON_WEBHOOK_SECRET=your_patreon_webhook_secret

# Vote webhooks from bot lists (POST /api/webhooks/vote/<site>); see BOT_LISTING.md
TOPGG_WEBHOOK_SECRET=
DISCORDBOTLIST_WEBHOOK_SECRET=
DISCORDS_WEBHOOK_SECRET=
BOTLISTME_WEBHOOK_SECRET=
VOIDBOTS_WEBHOOK_SECRET=
DISCORDPLACE_WEBHOOK_SECRET=
# Optional: Discord channel webhook that thanks voters publicly
VOTE_LOG_WEBHOOK_URL=
