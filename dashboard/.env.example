# Discord OAuth
AUTH_DISCORD_ID=your_discord_client_id
AUTH_DISCORD_SECRET=your_discord_client_secret

# Auth.js Secret (generate with: npx auth secret)
AUTH_SECRET=your_auth_secret_here

# Next.js
NEXTAUTH_URL=http://localhost:3001

# MongoDB Connection String (same as bot)
MONGODB_URI=mongodb://localhost:27017/music-bot

# Bot Configuration
DISCORD_BOT_TOKEN=your_bot_token
DISCORD_BOT_CLIENT_ID=your_bot_client_id
# Client-side accessible (for invite URLs)
NEXT_PUBLIC_DISCORD_BOT_CLIENT_ID=your_bot_client_id

# Linked Bots Encryption (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
BOT_ENCRYPTION_KEY=your_64_character_hex_encryption_key

# Patreon Integration (Optional - for premium features)
PATREON_CLIENT_ID=your_patreon_client_id
PATREON_CLIENT_SECRET=your_patreon_client_secret
PATREON_CREATOR_ACCESS_TOKEN=your_patreon_creator_access_token
PATREON_CAMPAIGN_ID=your_patreon_campaign_id
PATREON_WEBHOOK_SECRET=your_patreon_webhook_secret
