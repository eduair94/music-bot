# Discord Bot Token
TOKEN=your_bot_token_here

# Redis Connection
# Local:            redis://localhost:6379
# Docker Compose:   redis://redis:6379
REDIS_URL=redis://localhost:6379

# MongoDB Connection
# Local:            mongodb://localhost:27017/music-bot
# Docker Compose:   mongodb://mongo:27017/music-bot
MONGODB_URI=mongodb://localhost:27017/music-bot

# Bot Settings
MAX_PLAYLIST_SIZE=10
PRUNING=false
LOCALE=en
DEFAULT_VOLUME=100
STAY_TIME=30
OWNER_ID=your_discord_user_id

# Patreon Integration (optional)
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_CREATOR_ACCESS_TOKEN=
PATREON_CAMPAIGN_ID=
PATREON_WEBHOOK_SECRET=
PATREON_FOUNDER_TIER_ID=

# Bot Encryption Key for linked bots (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
BOT_ENCRYPTION_KEY=

# Google Gemini API key (preferred TTS provider for /say command)
GEMINI_API_KEY=

# Replicate API Token (fallback TTS provider; required for voice cloning)
REPLICATE_API_TOKEN=

# Debug Panel (secret web UI for live logs)
# Generate a random token: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Access at: http://<host>:9090/?token=<DEBUG_TOKEN>
DEBUG_TOKEN=
DEBUG_PORT=9090
