# Discord Bot Token
TOKEN=your_bot_token_here

# Bypass fleet (several bots per server, one /play). Each extra instance is
# its own Discord application running this same image with BOT_INSTANCE=<n>;
# docker-compose starts bot-2..bot-4 with `--profile fleet`.
# Application ids of the extra bots as "<instance>:<application id>" pairs,
# e.g. 2:111111111111111111,3:222222222222222222. Empty = only Bypass (no
# fleet behaviour). Put the same value in dashboard/.env.
FLEET_APPLICATION_IDS=
# Tokens of Bypass 2-4, each from its own application in the Developer Portal
TOKEN_2=
TOKEN_3=
TOKEN_4=
# Which instance this process is (set per service by docker-compose; 1 = primary)
# BOT_INSTANCE=1

# Redis Connection
# Local:            redis://localhost:6379
# Docker Compose:   redis://redis:6379
REDIS_URL=redis://localhost:6379

# MongoDB Connection
# Local:            mongodb://localhost:27017/music-bot
# Docker Compose:   mongodb://mongo:27017/music-bot
MONGODB_URI=mongodb://localhost:27017/music-bot

# Bot Settings
MAX_PLAYLIST_SIZE=10
PRUNING=false
LOCALE=en
DEFAULT_VOLUME=100
STAY_TIME=30
OWNER_ID=your_discord_user_id

# Patreon Integration (optional)
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_CREATOR_ACCESS_TOKEN=
# Lets the bot renew the creator token (it expires after about a month). Needs the client ID/secret above.
PATREON_CREATOR_REFRESH_TOKEN=
PATREON_CAMPAIGN_ID=
PATREON_WEBHOOK_SECRET=
PATREON_FOUNDER_TIER_ID=

# Bot Encryption Key for linked bots (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
BOT_ENCRYPTION_KEY=

# Google Gemini API key (preferred TTS provider for /say command)
GEMINI_API_KEY=

# Replicate API Token (fallback TTS provider; required for voice cloning)
REPLICATE_API_TOKEN=

# Debug Panel (secret web UI for live logs)
# Generate a random token: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Access at: http://<host>:9090/?token=<DEBUG_TOKEN>
DEBUG_TOKEN=
DEBUG_PORT=9090

# Telemetry event retention in days (botevents collection TTL)
BOT_EVENTS_TTL_DAYS=90

# GA4 Measurement Protocol (optional): server events bot_added / first_play / bot_removed
# for install attribution (services/growth/acquisition.ts). Same property as the site's
# NEXT_PUBLIC_GA_ID; the secret is in GA Admin > Data streams > web stream > Measurement Protocol.
GA_MEASUREMENT_ID=
GA_API_SECRET=

# Optional: Discord webhook of a private staff channel; /feedback posts land there
# (same value as FEEDBACK_WEBHOOK_URL in dashboard/.env). Feedback is stored in Mongo either way.
FEEDBACK_WEBHOOK_URL=

# Bot listing sites (optional; see BOT_LISTING.md). Set each after the listing is approved.
TOPGG_TOKEN=
DISCORDBOTLIST_TOKEN=
DISCORDBOTSGG_TOKEN=
DISCORDS_TOKEN=
BOTLISTME_TOKEN=
DISCORDLISTGG_TOKEN=
VOIDBOTS_TOKEN=
DISCORDPLACE_TOKEN=
RADARCORD_TOKEN=
BOTSONDISCORD_TOKEN=
