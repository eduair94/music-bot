# ── Next.js dashboard ────────────────────────────────────────────────────────
# Build context is the repository ROOT, not dashboard/: several dashboard
# modules import types from ../../shared, so shared/ must be inside the context.
#   docker build -f Dockerfile.dashboard .

# ── Stage 1: Install ALL dependencies (cached unless package*.json changes) ──
FROM node:22-slim AS deps

WORKDIR /app/dashboard

COPY dashboard/package*.json ./
RUN npm ci

# ── Stage 2: Build Next.js (re-runs only when source changes) ────────────────
FROM deps AS build

WORKDIR /app
COPY shared ./shared
COPY dashboard ./dashboard

WORKDIR /app/dashboard
RUN npm run build

# ── Stage 3: Production dependencies only (cached with stage 1) ──────────────
FROM deps AS prod-deps
RUN npm prune --omit=dev

# ── Stage 4: Final slim image ────────────────────────────────────────────────
FROM node:22-slim

WORKDIR /app/dashboard

ENV NODE_ENV=production

COPY --from=build /app/shared /app/shared
COPY --from=build /app/dashboard/.next ./.next
COPY --from=build /app/dashboard/public ./public
COPY --from=build /app/dashboard/package.json ./package.json
COPY --from=build /app/dashboard/next.config.mjs ./next.config.mjs
COPY --from=prod-deps /app/dashboard/node_modules ./node_modules

EXPOSE 4123

CMD ["npm", "run", "start"]
